benchmark:
  num_keys: 1000
  value_length: 10000
  init_rps: 10000
  test_duration: 10s
  rps: 2000
  key_distribution:
    zipf: 1.00001
  # key_distribution: sequential
  timeout: 1s
  retry_count: 3
  # file_path: ./full.jsonl
  file_path: ./lite.jsonl
  remote_script:
    # monitor_file_path: /workspace/client/monitor.full.jsonl
    # experiment_type: full
    monitor_file_path: /workspace/client/monitor.lite.jsonl
    experiment_type:
      lite: [4, "1024"]
    remote_addr: leveldb-server
    write_buffer_size: 268435456 # 256MB
    crash_time: 5s
redis:
  connection:
    addr:
      Tcp: ["leveldb-server", 6379]
      # Tcp: ["localhost", 6379]
    db: 0
  pool:
    max_size: 16
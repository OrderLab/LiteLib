benchmark:
  num_keys: 6000000
  key_length: 16
  value_length: 130
  test_duration: 3m
  rps: 20000
  key_distribution:
    zipf: 1.0
  # key_distribution: sequential
  write_ratio: 0.2
  timeout: 1s
  retry_count: 5
  inital_iter_count: 1
  enable_connection_pool: true
  check_correctness: false
  work_dir: /home/rishika/cascade/tests/LevelDB/src/tests/tmp-data
  # file_prefix: full
  # file_prefix: checkpoint
  # file_prefix: lite
  file_prefix: ebpf
  remote_script:
    root_dir: /home/rishika/cascade
    # experiment_type: full
    # cpu_limit: 4
    # experiment_type:
    #   checkpoint: 60
    # cpu_limit: 4
    # experiment_type:
    #   lite: [6, "87400"]
    # cpu_limit: 6
    experiment_type:
      ebpf: [5, "87400"]
    cpu_limit: 5
    remote_addr: node0
    remote_ssh_port: 22
    write_buffer_size: 536870912
    crash_time: 250s
redis:
  connection:
    addr:
      Tcp: ["node0", 6379]
    db: 0
  pool:
    max_size: 20
benchmark:
  num_keys: 100000
  key_length: 10
  value_length: 10000
  test_duration: 60s
  rps: 7000
  key_distribution:
    zipf: 1.0
  # key_distribution: sequential
  write_ratio: 0.2
  timeout: 1s
  retry_count: 5
  check_correctness: true
  file_prefix: full
  # file_prefix: checkpoint
  # file_prefix: lite
  remote_script:
    root_dir: /home/user/cascade
    experiment_type: full
    # experiment_type: checkpoint
    # experiment_type:
    #   lite: [4, "40960"]
    remote_addr: leveldb-server
    remote_ssh_port: 22
    write_buffer_size: 1073741824
    crash_time: 30s
redis:
  connection:
    addr:
      Tcp: ["leveldb-server", 6379]
      # Tcp: ["localhost", 6379]
    db: 0
  pool:
    max_size: 32
+#define on_connection_def(func_name, fd_name)                              \
+  void RLServer::func_name(struct ev_loop *loop, ev_io *watcher,           \
+                           int revents) {                                  \
+    RLServer *s = static_cast<RLServer *>(watcher->data);                  \
+    if (EV_ERROR & revents) {                                              \
+      puts("on_connection() got error event, closing server.");            \
+      return;                                                              \
+    }                                                                      \
+                                                                           \
+    struct sockaddr_in addr; /* connector's address information */         \
+    socklen_t addr_len = sizeof(addr);                                     \
+    int conn_fd = accept(s->fd_name, (struct sockaddr *)&addr, &addr_len); \
+                                                                           \
+    if (conn_fd < 0) {                                                     \
+      perror("accept()");                                                  \
+      return;                                                              \
+    }                                                                      \
+                                                                           \
+    int flags = 1;                                                         \
+    setsockopt(s->fd_name, IPPROTO_TCP, TCP_NODELAY, (void *)&flags,       \
+               sizeof(flags));                                             \
+                                                                           \
+    RLConnection *connection = new RLConnection(s, conn_fd);               \
+                                                                           \
+    if (connection == NULL) {                                              \
+      close(conn_fd);                                                      \
+      return;                                                              \
+    }                                                                      \
+    connection->start();                                                   \
+  }
+

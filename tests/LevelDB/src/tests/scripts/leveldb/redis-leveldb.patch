+void RLRequest::rl_getset(){
+    if(args.size()!=2){
+        connection->write_error("ERR wrong number of arguments for 'set' command");
+        return;
+    }
+
+    std::string out;
+    leveldb::Status status_get;
+    status_get = connection->server->db[connection->db_index]->Get(connection->server->read_options,
+             args[0], &out);
+
+    leveldb::Status status_set;
+    status_set = connection->server->db[connection->db_index]->Put(connection->server->write_options,
+             args[0], args[1]);
+
+    if(!status_get.ok() && !status_get.IsNotFound()) {
+        connection->write_error("GETSET ERROR 1");
+    } else if(!status_set.ok()) {
+        connection->write_error("GETSET ERROR 2");
+    } else if(status_get.IsNotFound()) {
+        connection->write_nil();
+    } else if(status_get.ok()) {
+        connection->write_bulk(out);
+    }
+}

diff --git a/git_diff_workspace.sh b/git_diff_workspace.sh
new file mode 100755
index 0000000..efd7958
--- /dev/null
+++ b/git_diff_workspace.sh
@@ -0,0 +1,26 @@
+rm ../scripts/leveldb/redis-leveldb.ebpf.patch
+
+# Get tracked file changes
+git diff > ../scripts/leveldb/redis-leveldb.ebpf.patch
+
+# Append untracked file changes
+(
+    # First handle the build directory specially if it exists
+    if [ -d "vendor/LiteSys/build" ]; then
+        # Temporarily add the build directory to git to get a proper diff
+        git add vendor/LiteSys/build
+        git diff --cached vendor/LiteSys/build
+        git reset vendor/LiteSys/build 2>/dev/null
+    fi
+
+    # Then handle all other untracked files
+    git ls-files --others --exclude-standard -z | tr '\0' '\n' | grep -v "^redis-leveldb-vanilla" | while IFS= read -r path; do
+        if [ -d "$path" ] && [ "$path" != "vendor/LiteSys/build" ]; then
+            find "$path" -type f -o -type l 2>/dev/null
+        elif [ ! -d "$path" ]; then
+            echo "$path"
+        fi
+    done | while IFS= read -r file; do
+        git --no-pager diff --no-index /dev/null "$file" 2>/dev/null || true
+    done
+) | grep -v "^Unstaged changes after reset:" | grep -v "^M	" >> ../scripts/leveldb/redis-leveldb.ebpf.patch
diff --git a/src/litesys.cpp b/src/litesys.cpp
new file mode 100644
index 0000000..68310e7
--- /dev/null
+++ b/src/litesys.cpp
@@ -0,0 +1,26 @@
+#include "litesys.hpp"
+#include "rl_connection.h"
+#include "rl_server.h"
+#include <future>
+void LiteFlushWriteBuffer(void *conn) {
+  RLConnection *c = static_cast<RLConnection *>(conn);
+  ev_clear_pending(c->loop, &c->write_watcher);
+}
+
+void LiteReinstallClientEventHandler(void *client, int install) {
+  RLConnection *c = static_cast<RLConnection *>(client);
+  c->async_done_promise = std::promise<void>();
+  std::future<void> fut = c->async_done_promise.get_future();
+  c->install = install;
+  ev_async_send(c->loop, &c->async_watcher);
+  fut.wait();
+}
+
+void LiteReinstallListenerEventHandler(void *listener, int install) {
+  RLServer *s = static_cast<RLServer *>(listener);
+  s->async_done_promise = std::promise<void>();
+  std::future<void> fut = s->async_done_promise.get_future();
+  s->install = install;
+  ev_async_send(s->loop, &s->async_watcher);
+  fut.wait();
+}

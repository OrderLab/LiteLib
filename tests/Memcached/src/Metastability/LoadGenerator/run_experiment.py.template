    run_TraceReplay_command = "./TraceReplay -t {}  {} -n {} -r {} -s {} -m \"{}\" -k {}".format(_trace_file_name, closed_loop_flag, _num_threads, _result_file_name, _memcached_host, _memcached_monitor_command, row_nums_in_db)
    print(run_TraceReplay_command)

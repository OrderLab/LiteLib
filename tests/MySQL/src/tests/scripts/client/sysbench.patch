+static uint64_t now_us(void)
+{
+  struct timespec ts;
+
+#ifdef HAVE_CLOCK_GETTIME
+  clock_gettime(CLOCK_REALTIME, &ts);
+#else
+  struct timeval tv;
+  gettimeofday(&tv, NULL);
+  ts.tv_sec = tv.tv_sec;
+  ts.tv_nsec = tv.tv_usec * 1000;
+#endif
+
+  return (uint64_t) ts.tv_sec * US_PER_SEC + (uint64_t) (ts.tv_nsec / 1000);
+}
+
+static const char *current_host_label(const db_mysql_conn_t *db_mysql_con)
+{
+  return (db_mysql_con->host_label != NULL) ? db_mysql_con->host_label : empty_host_label;
+}
+
+/*
+  Reconnect on transport loss without replaying the failed statement.
+  Service gap is measured from the first loss error to the first successful
+  query after reconnect.
+*/
+static void failover_start(db_conn_t *sb_con, unsigned int err)
+{
+  db_mysql_conn_t *db_mysql_con = (db_mysql_conn_t *) sb_con->ptr;
+
+  if (db_mysql_con->in_failover)
+    return;
+
+  db_mysql_con->in_failover = true;
+  db_mysql_con->failover_start_us = now_us();
+  db_mysql_con->failover_seq++;
+
+  free(db_mysql_con->failover_old_host);
+  free(db_mysql_con->failover_new_host);
+  db_mysql_con->failover_old_host = strdup(current_host_label(db_mysql_con));
+  db_mysql_con->failover_new_host = NULL;
+
+  log_text(LOG_NOTICE,
+           "FAILOVER_START tid=%d seq=%" PRIu64 " old_host=%s t_us=%" PRIu64
+           " errno=%u",
+           sb_con->thread_id,
+           db_mysql_con->failover_seq,
+           current_host_label(db_mysql_con),
+           db_mysql_con->failover_start_us,
+           err);
+}
+
+static void failover_mark_reconnected(db_conn_t *sb_con)
+{
+  db_mysql_conn_t *db_mysql_con = (db_mysql_conn_t *) sb_con->ptr;
+
+  if (!db_mysql_con->in_failover)
+    return;
+
+  free(db_mysql_con->failover_new_host);
+  db_mysql_con->failover_new_host = strdup(current_host_label(db_mysql_con));
+}
+
+static void failover_end_if_needed(db_conn_t *sb_con)
+{
+  db_mysql_conn_t *db_mysql_con = (db_mysql_conn_t *) sb_con->ptr;
+
+  if (!db_mysql_con->in_failover || db_mysql_con->failover_new_host == NULL)
+    return;
+
+  const uint64_t end_us = now_us();
+  const uint64_t gap_us = end_us - db_mysql_con->failover_start_us;
+
+  log_text(LOG_NOTICE,
+           "FAILOVER_END tid=%d seq=%" PRIu64 " new_host=%s start_us=%" PRIu64
+           " end_us=%" PRIu64 " gap_us=%" PRIu64,
+           sb_con->thread_id,
+           db_mysql_con->failover_seq,
+           db_mysql_con->failover_new_host,
+           db_mysql_con->failover_start_us,
+           end_us,
+           gap_us);
+
+  db_mysql_con->in_failover = false;
+  free(db_mysql_con->failover_old_host);
+  free(db_mysql_con->failover_new_host);
+  db_mysql_con->failover_old_host = NULL;
+  db_mysql_con->failover_new_host = NULL;
+}
+
+static bool is_connection_loss_error(unsigned int err)
+{
+  switch (err)
+  {
+  case CR_SERVER_LOST:
+  case CR_SERVER_GONE_ERROR:
+  case CR_TCP_CONNECTION:
+#ifdef CR_SERVER_LOST_EXTENDED
+  case CR_SERVER_LOST_EXTENDED:
+#endif
+  case ER_SERVER_SHUTDOWN:
+    return true;
+  default:
+    break;
+  }
+
+  return false;
+}
+
+static void trim_space(char *s)
+{
+  char *start = s;
+  char *end;
+
+  while (*start == ' ' || *start == '\t' || *start == '\n' || *start == '\r')
+    start++;
+
+  end = start + strlen(start);
+  while (end > start &&
+         (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' || end[-1] == '\r'))
+    end--;
+
+  if (start != s)
+    memmove(s, start, (size_t)(end - start));
+
+  s[end - start] = '\0';
+}
+
+static char *sb_strndup(const char *s, size_t n)
+{
+  char *out = (char *) malloc(n + 1);
+  if (out == NULL)
+    return NULL;
+  memcpy(out, s, n);
+  out[n] = '\0';
+  return out;
+}
+
+static void set_host_label(db_mysql_conn_t *db_mysql_con,
+                           const char *host, unsigned int port)
+{
+  free(db_mysql_con->host_label);
+  db_mysql_con->host_label = NULL;
+
+  if (host == NULL)
+    return;
+
+  if (port == 0)
+  {
+    db_mysql_con->host_label = strdup(host);
+    return;
+  }
+
+  if (strchr(host, ':') != NULL && host[0] != '[')
+  {
+    char buf[512];
+    snprintf(buf, sizeof(buf), "[%s]:%u", host, port);
+    db_mysql_con->host_label = strdup(buf);
+    return;
+  }
+
+  {
+    char buf[512];
+    snprintf(buf, sizeof(buf), "%s:%u", host, port);
+    db_mysql_con->host_label = strdup(buf);
+  }
+}
+
+static int parse_host_token(const char *token,
+                            char **host_out,
+                            unsigned int *port_out)
+{
+  char *host = NULL;
+  unsigned int port = args.host_raw_default_port;
+
+  if (token[0] == '[')
+  {
+    const char *end = strchr(token, ']');
+    if (end == NULL)
+      return 1;
+    host = sb_strndup(token + 1, (size_t)(end - token - 1));
+    if (host == NULL)
+      return 1;
+    if (end[1] == ':' && end[2] != '\0')
+    {
+      port = (unsigned int) atoi(end + 2);
+    }
+  }
+  else
+  {
+    const char *first_colon = strchr(token, ':');
+    const char *last_colon = strrchr(token, ':');
+    if (first_colon != NULL && first_colon == last_colon && last_colon[1] != '\0')
+    {
+      host = sb_strndup(token, (size_t)(last_colon - token));
+      if (host == NULL)
+        return 1;
+      port = (unsigned int) atoi(last_colon + 1);
+    }
+    else
+    {
+      host = strdup(token);
+      if (host == NULL)
+        return 1;
+    }
+  }
+
+  *host_out = host;
+  *port_out = port;
+  return 0;
+}
+
+static int parse_host_raw_list(const char *raw)
+{
+  char *tmp;
+  char *token;
+  unsigned int count = 0;
+
+  free_host_raw_entries();
+
+  if (raw == NULL || raw[0] == '\0')
+    return 0;
+
+  tmp = strdup(raw);
+  if (tmp == NULL)
+    return 1;
+
+  for (token = strtok(tmp, ","); token != NULL; token = strtok(NULL, ","))
+  {
+    trim_space(token);
+    if (token[0] == '\0')
+      continue;
+
+    mysql_host_entry_t *entries =
+      (mysql_host_entry_t *) realloc(args.host_raw_entries,
+                                     sizeof(mysql_host_entry_t) * (count + 1));
+    if (entries == NULL)
+    {
+      free(tmp);
+      free_host_raw_entries();
+      return 1;
+    }
+    args.host_raw_entries = entries;
+
+    if (parse_host_token(token,
+                         &args.host_raw_entries[count].host,
+                         &args.host_raw_entries[count].port) != 0)
+    {
+      free(tmp);
+      free_host_raw_entries();
+      return 1;
+    }
+
+    if (strchr(args.host_raw_entries[count].host, ':') != NULL)
+    {
+      char buf[512];
+      snprintf(buf, sizeof(buf), "[%s]:%u",
+               args.host_raw_entries[count].host,
+               args.host_raw_entries[count].port);
+      args.host_raw_entries[count].hostport = strdup(buf);
+    }
+    else
+    {
+      char buf[512];
+      snprintf(buf, sizeof(buf), "%s:%u",
+               args.host_raw_entries[count].host,
+               args.host_raw_entries[count].port);
+      args.host_raw_entries[count].hostport = strdup(buf);
+    }
+
+    if (args.host_raw_entries[count].hostport == NULL)
+    {
+      free(tmp);
+      free_host_raw_entries();
+      return 1;
+    }
+
+    count++;
+  }
+
+  free(tmp);
+
+  args.host_raw_count = count;
+  return 0;
+}
+
+static void free_host_raw_entries(void)
+{
+  if (args.host_raw_entries == NULL)
+    return;
+
+  for (unsigned int i = 0; i < args.host_raw_count; i++)
+  {
+    free(args.host_raw_entries[i].host);
+    free(args.host_raw_entries[i].hostport);
+  }
+
+  free(args.host_raw_entries);
+  args.host_raw_entries = NULL;
+  args.host_raw_count = 0;
+}
+
 

+  // Helper method to acquire a lock with timeout
+  private boolean acquireLock(String key) {
+    ReentrantLock lock = getLockForKey(key);
+    try {
+      return lock.tryLock(LOCK_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+      return false;
+    }
+  }
+  
+  // Helper method to release a lock
+  private void releaseLock(String key) {
+    ReentrantLock lock = KEY_LOCKS.get(key);
+    if (lock != null && lock.isHeldByCurrentThread()) {
+      lock.unlock();
+    }
+  }

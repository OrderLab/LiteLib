diff --git a/src/litesys.c b/src/litesys.c
new file mode 100644
index 000000000..065e155a9
--- /dev/null
+++ b/src/litesys.c
@@ -0,0 +1,100 @@
+#include "litesys.h"
+
+#include <embedded_lite.h>
+
+void LiteProtectOriginalRequest(client *c) {
+  if (c->cmd->proc == setCommand) {
+    // tryObjectEncoding in setCommand will change the argv[2], and it forgets
+    // to call retainOriginalCommandVector
+    retainOriginalCommandVector(c);
+  }
+}
+
+void LiteQueueEmbeddedRequest(client *c) {
+  if (!(c->cmd->proc == setCommand || c->cmd->proc == hsetCommand)) {
+    return;
+  }
+
+  EmbeddedRequest *request = zmalloc(sizeof(EmbeddedRequest));
+
+  if (c->cmd->proc == setCommand) {
+    request->type = kSet;
+  } else if (c->cmd->proc == hsetCommand) {
+    request->type = kHset;
+  }
+
+  request->argc = c->original_argv ? c->original_argc : c->argc;
+
+  robj **orig_argv = c->original_argv ? c->original_argv : c->argv;
+  request->argv = zmalloc(sizeof(robj *) * request->argc);
+  request->argv_len = zmalloc(sizeof(int) * request->argc);
+  for (int i = 0; i < request->argc; i++) {
+    incrRefCount(orig_argv[i]);
+    request->argv[i] = orig_argv[i];
+    request->argv_len[i] = sdslen(orig_argv[i]->ptr);
+  }
+
+  LiteProcessRequest(c->litesys_data, request);
+}
+
+void LiteFreeEmbeddedRequest(void *arg) {
+  EmbeddedRequest *request = (EmbeddedRequest *)arg;
+  for (int i = 0; i < request->argc; i++) {
+    decrRefCount(request->argv[i]);
+  }
+  zfree(request->argv_len);
+  zfree(request->argv);
+  zfree(request);
+}
+
+void LiteFlushWriteBuffer(void *arg) {
+  client *c = (client *)arg;
+  sendReplyToClient(c->conn);
+}
+
+void LiteReinstallClientEventHandler(void *arg, int install) {
+  client *c = (client *)arg;
+  if (!install) {
+    serverLog(LL_WARNING, "Uninstalling client event handler for client %d",
+              c->conn->fd);
+    aeDeleteFileEvent(server.el, c->conn->fd, AE_WRITABLE);
+    aeDeleteFileEvent(server.el, c->conn->fd, AE_READABLE);
+  } else {
+    serverLog(LL_WARNING, "Installing client event handler for client %d",
+              c->conn->fd);
+    if (aeCreateFileEvent(server.el, c->conn->fd, AE_WRITABLE,
+                          c->conn->type->ae_handler, c->conn) == AE_ERR) {
+      serverLog(LL_WARNING, "Failed to install client write event handler");
+    }
+    if (aeCreateFileEvent(server.el, c->conn->fd, AE_READABLE,
+                          c->conn->type->ae_handler, c->conn) == AE_ERR) {
+      /* Rollback */
+      aeDeleteFileEvent(server.el, c->conn->fd, AE_WRITABLE);
+      serverLog(LL_WARNING, "Failed to install client read event handler");
+    }
+  }
+}
+
+void LiteReinstallListenerEventHandler(void *arg, int install) {
+  connListener *sfd = (connListener *)arg;
+  if (!install) {
+    for (int i = 0; i < sfd->count; i++) {
+      serverLog(LL_WARNING,
+                "Uninstalling listener read event handler for fd %d",
+                sfd->fd[i]);
+      aeDeleteFileEvent(server.el, sfd->fd[i], AE_READABLE);
+    }
+  } else {
+    for (int i = 0; i < sfd->count; i++) {
+      serverLog(LL_WARNING, "Installing listener read event handler for fd %d",
+                sfd->fd[i]);
+      if (aeCreateFileEvent(server.el, sfd->fd[i], AE_READABLE,
+                            sfd->ct->accept_handler, sfd) == AE_ERR) {
+        /* Rollback */
+        for (int j = i - 1; j >= 0; j--)
+          aeDeleteFileEvent(server.el, sfd->fd[j], AE_READABLE);
+        serverLog(LL_WARNING, "Failed to install listener read event handler");
+      }
+    }
+  }
+}

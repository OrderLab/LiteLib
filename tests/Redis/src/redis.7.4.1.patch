+  int *argv_len;
+} EmbeddedRequest;
+
+void LiteProtectOriginalRequest(client *c);
+
+void LiteQueueEmbeddedRequest(client *c);
+
+void LiteFreeEmbeddedRequest(EmbeddedRequest *request);

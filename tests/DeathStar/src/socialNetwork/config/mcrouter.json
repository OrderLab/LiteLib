{
  "pools": {
     "A": {
        "servers": [
          "post-storage-memcached-1:11211",
          "post-storage-memcached-2:11211"
        ]
     }
  },
  "route": {
    "type": "OperationSelectorRoute",
    "operation_policies": {
      "get": {
        "type": "FailoverRoute",
        "children": [
          "HashRoute|Pool|A",
          "Pool|A"
        ]
      }
    },
    "default_policy": "AllFastestRoute|Pool|A"
  }
}

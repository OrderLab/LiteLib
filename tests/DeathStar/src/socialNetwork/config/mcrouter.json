{
  "pools": {
     "A": {
        "servers": [
          "post-storage-memcached-1:11211"
        ]
     },
     "B": {
        "servers": [
          "post-storage-memcached-2:11211"
        ]
     }
  },
  "route": {
    "type": "OperationSelectorRoute",
    "operation_policies": {
      "get": {
        "type": "FailoverRoute",
        "children": [
          {
            "type": "HashRoute",
            "children": [
              "Pool|A",
              "Pool|B"
            ]
          },
          "Pool|A",
          "Pool|B"
        ]
      }
    },
    "default_policy": {
      "type": "AllFastestRoute",
      "children": [
        "Pool|A",
        "Pool|B"
      ]
    }
  }
}
